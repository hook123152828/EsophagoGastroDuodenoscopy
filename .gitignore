# External model projects — read-only dependencies, fetched separately.
# Their weights alone are >3GB, well past GitHub's file limits. See README.md.
/CGI/
/GIM/
/GNS/
/GutCore/

# Procedure videos (multi-GB) and their annotation sheets
/video/

# Model weights anywhere
*.pth
*.pt
*.onnx

# Runtime artifacts
/backend/sessions/*
!/backend/sessions/.gitkeep
/logs/
*.pid

# Python
__pycache__/
*.pyc

# Node / build
node_modules/
dist/
*.tsbuildinfo

# Tooling
.playwright-mcp/
*.png
!docs/*.png
.vscode/
